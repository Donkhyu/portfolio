---
import BaseLayout from '../layouts/BaseLayout.astro';

// Internal design-system reference. Renders the whole system on one page
// (both modes, type, form, and the dialed-up motif art) for sign-off.
const dayColors = [
  { name: 'bg / paper', token: '--c-paper', hex: '#F6F1EA' },
  { name: 'raised', token: '--c-raised', hex: '#ECE4D9' },
  { name: 'border', token: '--c-border', hex: '#DDD2C4' },
  { name: 'text', token: '--c-ink', hex: '#332C26', ratio: '12.2 ✓ AAA' },
  { name: 'muted', token: '--c-ink-muted', hex: '#6B6259', ratio: '5.3 ✓ AA' },
  { name: 'heading', token: '--c-head', hex: '#241E18', ratio: '14.7 ✓ AAA' },
  { name: 'accent', token: '--c-accent-day', hex: '#925826', ratio: '5.1 ✓ AA' },
  { name: 'secondary', token: '--c-plum-day', hex: '#7A5366', ratio: '5.7 ✓ AA' },
];
const nightColors = [
  { name: 'bg / base', token: '--c-base', hex: '#16110D' },
  { name: 'raised', token: '--c-base-2', hex: '#211B16' },
  { name: 'text', token: '--c-cream', hex: '#E9DECF', ratio: '14.1 ✓ AAA' },
  { name: 'heading', token: '--c-cream-hi', hex: '#F2E7D7', ratio: '15.3 ✓ AAA' },
  { name: 'accent', token: '--c-accent-night', hex: '#CE9866', ratio: '7.4 ✓ AAA' },
  { name: 'secondary', token: '--c-plum-night', hex: '#A6788E', ratio: '5.0 ✓ AA' },
];
const typeScale = [
  { label: 'fs-3 / hero', cls: 's3' },
  { label: 'fs-2 / section', cls: 's2' },
  { label: 'fs-1 / subhead', cls: 's1' },
  { label: 'fs-0 / body', cls: 's0' },
  { label: 'fs--1 / small', cls: 'sm1' },
];

// Single-stroke line art (currentColor). Inlined here for sign-off;
// extracted to src/components/art/ during rollout.
const S = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const iconCup = `<svg viewBox="0 0 24 24" ${S}><path d="M5 10h12v5a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z"/><path d="M17 11h2.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3.5c-.7 1-.7 2 0 3M12 3.5c-.7 1-.7 2 0 3"/></svg>`;
const iconBeans = `<svg viewBox="0 0 24 24" ${S}><ellipse cx="9" cy="10" rx="3.5" ry="5" transform="rotate(-25 9 10)"/><path d="M8 6.5c1 1.5 1 5-.5 7" transform="rotate(-25 9 10)"/><ellipse cx="15.5" cy="15" rx="3.5" ry="5" transform="rotate(-25 15.5 15)"/></svg>`;
const iconBall = `<svg viewBox="0 0 24 24" ${S}><circle cx="12" cy="12" r="9"/><path d="M12 3c2.5 3 3 6 0 9s-6 3-8.6 1.2"/><path d="M21 12c-3 .5-6 0-8-3S9 3.5 8.5 3.2"/><path d="M4 7.5c3 2 6 3 9 2.5"/></svg>`;
const iconVinyl = `<svg viewBox="0 0 24 24" ${S}><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/><circle cx="12" cy="12" r="0.6" fill="currentColor"/></svg>`;
const iconCassette = `<svg viewBox="0 0 24 24" ${S}><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="9" cy="12" r="1.8"/><circle cx="15" cy="12" r="1.8"/><path d="M8 18l1.5-2.5h5L16 18"/></svg>`;
const iconEq = `<svg viewBox="0 0 24 24" ${S}><path d="M6 15v4M10 9v10M14 5v14M18 12v7"/></svg>`;

const SI = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const illoPourover = `<svg viewBox="0 0 64 64" ${SI}><path d="M18 14h28l-6 12H24z"/><path d="M28 26l-2 6M36 26l2 6"/><path d="M22 40h20l-2 12a3 3 0 0 1-3 3H27a3 3 0 0 1-3-3z"/><path d="M30 34v3M34 35v3"/></svg>`;
const illoBall = `<svg viewBox="0 0 64 64" ${SI}><circle cx="32" cy="32" r="22"/><path d="M32 10c7 8 8 16 0 24s-15 8-22 3"/><path d="M54 32c-8 1-16 0-21-8S22 11 21 10"/><path d="M11 20c8 5 16 7 24 5"/></svg>`;
const illoRecord = `<svg viewBox="0 0 64 64" ${SI}><circle cx="32" cy="32" r="22"/><circle cx="32" cy="32" r="13"/><circle cx="32" cy="32" r="7"/><circle cx="32" cy="32" r="1.6" fill="currentColor"/><path d="M48 16c4 4 6 9 6 16" stroke-width="1.4"/></svg>`;
---

<BaseLayout title="Styleguide">
  <div class="sg container">
    <header class="sg-head">
      <p class="eyebrow">Design system · internal</p>
      <h1>Quiet canvas, loud accents</h1>
      <p class="sg-lede">
        Atkinson Hyperlegible Next (sans, everything) + Atkinson Hyperlegible Mono (labels only),
        a pared-back warm palette, and a dialed-up motif layer. The restraint up here is what
        lets the motifs below be bold.
      </p>
    </header>

    <!-- TYPOGRAPHY -->
    <section class="sg-section">
      <h2 class="sg-h">Typography</h2>
      <div class="type-scale">
        {typeScale.map((t) => (
          <div class="type-row">
            <span class="mono tag">{t.label}</span>
            <span class={`samp ${t.cls}`}>Set &amp; spike — warm software.</span>
          </div>
        ))}
      </div>
      <p class="mono tag" style="margin-top:1.5rem">Mono · used only for labels, tags, code →</p>
      <p class="mono mono-samp">const brew = await pourOver(beans);  // 0123456789</p>
    </section>

    <!-- COLOR -->
    <section class="sg-section">
      <h2 class="sg-h">Color — both modes, with WCAG ratios</h2>
      <div class="modes">
        <div class="mode mode-day">
          <p class="mode-label">Day Roast</p>
          <div class="swatches">
            {dayColors.map((c) => (
              <div class="sw">
                <span class="chip" style={`background:${c.hex}`}></span>
                <span class="sw-meta">
                  <b>{c.name}</b>
                  <span class="mono">{c.hex}</span>
                  {c.ratio && <span class="mono ratio">{c.ratio}</span>}
                </span>
              </div>
            ))}
          </div>
        </div>
        <div class="mode mode-night">
          <p class="mode-label">Late Night</p>
          <div class="swatches">
            {nightColors.map((c) => (
              <div class="sw">
                <span class="chip" style={`background:${c.hex}`}></span>
                <span class="sw-meta">
                  <b>{c.name}</b>
                  <span class="mono">{c.hex}</span>
                  {c.ratio && <span class="mono ratio">{c.ratio}</span>}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FORM -->
    <section class="sg-section">
      <h2 class="sg-h">Form — buttons, badges, radii, shadow</h2>
      <div class="form-row">
        <span class="btn btn-primary">Primary</span>
        <span class="btn btn-ghost">Ghost</span>
        <span class="badge b-shipped">Shipped</span>
        <span class="badge b-brewing">Brewing</span>
        <span class="badge b-idea">Idea</span>
      </div>
      <div class="form-row">
        <span class="box r-s">radius-s</span>
        <span class="box r-m">radius-m</span>
        <span class="box r-l">radius-l</span>
        <span class="box shadow">shadow-warm</span>
      </div>
    </section>

    <!-- MOTIF ICONS -->
    <section class="sg-section">
      <h2 class="sg-h">Motif icons — single-stroke line art</h2>
      <div class="icons">
        <figure><span set:html={iconCup} /><figcaption class="mono">cup</figcaption></figure>
        <figure><span set:html={iconBeans} /><figcaption class="mono">beans</figcaption></figure>
        <figure><span set:html={iconBall} /><figcaption class="mono">volleyball</figcaption></figure>
        <figure><span set:html={iconVinyl} /><figcaption class="mono">vinyl</figcaption></figure>
        <figure><span set:html={iconCassette} /><figcaption class="mono">cassette</figcaption></figure>
        <figure><span set:html={iconEq} /><figcaption class="mono">equalizer</figcaption></figure>
      </div>
    </section>

    <!-- MOTIF ILLUSTRATIONS -->
    <section class="sg-section">
      <h2 class="sg-h">Feature illustrations — one per section</h2>
      <div class="illos">
        <figure><span set:html={illoPourover} /><figcaption class="mono">coffee → The Menu</figcaption></figure>
        <figure><span set:html={illoBall} /><figcaption class="mono">volleyball → Set &amp; Spike</figcaption></figure>
        <figure><span set:html={illoRecord} /><figcaption class="mono">R&amp;B → On the Record</figcaption></figure>
      </div>
    </section>

    <!-- MOTIF BACKGROUNDS -->
    <section class="sg-section">
      <h2 class="sg-h">Decorative backgrounds — low opacity, behind type</h2>
      <div class="bgs">
        <div class="bg-tile"><div class="bg-ring"></div><span class="bg-cap mono">coffee rings</span></div>
        <div class="bg-tile"><div class="bg-court"></div><span class="bg-cap mono">court lines</span></div>
        <div class="bg-tile"><div class="bg-grooves"></div><span class="bg-cap mono">vinyl grooves</span></div>
      </div>
    </section>
  </div>
</BaseLayout>

<script lang="ts" is:inline></script>

<style>
  .sg { padding-block: var(--space-xl) var(--space-3xl); }
  .sg-head { margin-bottom: var(--space-2xl); }
  .sg-lede { color: var(--text-muted); max-width: 60ch; margin-top: var(--space-s); }
  .sg-section { margin-bottom: var(--space-2xl); }
  .sg-h {
    font-size: var(--fs-1);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-l);
  }
  .mono { font-family: var(--font-mono); }
  .tag {
    font-size: var(--fs--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  /* type scale */
  .type-row { display: flex; align-items: baseline; gap: var(--space-m); padding-block: var(--space-2xs); border-bottom: 1px dotted var(--border); }
  .type-row .tag { flex: 0 0 9rem; color: var(--text-muted); }
  .samp { color: var(--heading); font-weight: 760; letter-spacing: -0.02em; }
  .s3 { font-size: var(--fs-3); }
  .s2 { font-size: var(--fs-2); }
  .s1 { font-size: var(--fs-1); }
  .s0 { font-size: var(--fs-0); font-weight: 400; color: var(--text); }
  .sm1 { font-size: var(--fs--1); font-weight: 400; color: var(--text-muted); }
  .mono-samp {
    font-family: var(--font-mono);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    padding: var(--space-2xs) var(--space-s);
    color: var(--text);
    font-size: var(--fs--1);
  }

  /* color modes */
  .modes { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l); }
  .mode { border: 1px solid var(--border); border-radius: var(--radius-m); padding: var(--space-m); }
  .mode-day {
    --bg: var(--c-paper); --bg-raised: var(--c-raised); --border: var(--c-border);
    --text: var(--c-ink); --text-muted: var(--c-ink-muted); --heading: var(--c-head);
    --accent: var(--c-accent-day); --accent-2: var(--c-plum-day);
    background: var(--c-paper); color: var(--c-ink);
  }
  .mode-night {
    --bg: var(--c-base); --bg-raised: var(--c-base-2);
    --text: var(--c-cream); --heading: var(--c-cream-hi);
    --accent: var(--c-accent-night); --accent-2: var(--c-plum-night);
    background: var(--c-base); color: var(--c-cream);
    border-color: color-mix(in srgb, var(--c-cream) 14%, transparent);
  }
  .mode-label { font-family: var(--font-mono); font-size: var(--fs--1); text-transform: uppercase; letter-spacing: var(--tracking-wide); margin-bottom: var(--space-s); opacity: 0.7; }
  .swatches { display: grid; gap: var(--space-2xs); }
  .sw { display: flex; align-items: center; gap: var(--space-s); }
  .chip { width: 2.5rem; height: 2.5rem; border-radius: var(--radius-s); border: 1px solid color-mix(in srgb, currentColor 20%, transparent); flex: none; }
  .sw-meta { display: flex; flex-direction: column; line-height: 1.3; }
  .sw-meta b { font-weight: 700; font-size: var(--fs--1); }
  .sw-meta .mono { font-size: 0.75rem; opacity: 0.75; }
  .ratio { color: var(--accent) !important; opacity: 1 !important; }

  /* form */
  .form-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); margin-bottom: var(--space-m); }
  .btn { padding: 0.6em 1.3em; border-radius: var(--radius-pill); font-weight: 600; font-size: var(--fs--1); }
  .btn-primary { background: var(--accent); color: var(--on-accent); }
  .btn-ghost { border: 1px solid var(--border); background: var(--bg-raised); color: var(--text); }
  .badge { font-family: var(--font-mono); font-size: var(--fs--1); text-transform: uppercase; letter-spacing: var(--tracking-wide); padding: 0.15em 0.6em; border-radius: var(--radius-pill); border: 1px solid currentColor; }
  .b-shipped { color: var(--c-sage); }
  .b-brewing { color: var(--accent); }
  .b-idea { color: var(--accent-2); }
  .box { display: inline-flex; align-items: center; justify-content: center; width: 7rem; height: 4rem; background: var(--bg-raised); border: 1px solid var(--border); font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); }
  .r-s { border-radius: var(--radius-s); }
  .r-m { border-radius: var(--radius-m); }
  .r-l { border-radius: var(--radius-l); }
  .shadow { border-radius: var(--radius-m); box-shadow: var(--shadow-warm); }

  /* icons + illos */
  .icons { display: flex; flex-wrap: wrap; gap: var(--space-l); }
  .icons figure { display: grid; gap: var(--space-2xs); justify-items: center; margin: 0; color: var(--heading); }
  .icons :global(svg) { width: 36px; height: 36px; }
  .illos { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-l); }
  .illos figure { display: grid; gap: var(--space-s); justify-items: center; margin: 0; padding: var(--space-l); border: 1px solid var(--border); border-radius: var(--radius-m); color: var(--heading); background: var(--bg-raised); }
  .illos :global(svg) { width: 110px; height: 110px; }
  .icons figcaption, .illos figcaption { font-size: 0.75rem; color: var(--text-muted); }
  .icons :global(svg) :global(*), .illos :global(svg) :global(*) { vector-effect: non-scaling-stroke; }

  /* backgrounds */
  .bgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-l); }
  .bg-tile { position: relative; height: 9rem; border: 1px solid var(--border); border-radius: var(--radius-m); overflow: hidden; background: var(--bg-raised); }
  .bg-cap { position: absolute; bottom: 0.5rem; left: 0.5rem; font-size: 0.7rem; color: var(--text-muted); z-index: 1; }
  .bg-ring::before, .bg-ring::after { content: ''; position: absolute; border: 2px solid var(--accent); border-radius: 50%; opacity: 0.14; }
  .bg-ring::before { width: 7rem; height: 7rem; top: -1.5rem; left: 1rem; }
  .bg-ring::after { width: 4rem; height: 4rem; bottom: -0.5rem; right: 1.5rem; }
  .bg-court { position: absolute; inset: 1rem; border: 2px solid var(--accent); opacity: 0.16; }
  .bg-court::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; border-left: 2px solid var(--accent); }
  .bg-grooves { position: absolute; inset: 0; background: repeating-radial-gradient(circle at 30% 120%, transparent 0 8px, var(--accent) 8px 9px); opacity: 0.12; }

  @media (max-width: 40rem) {
    .modes { grid-template-columns: 1fr; }
    .type-row { flex-direction: column; gap: 0.1rem; align-items: flex-start; }
    .type-row .tag { flex-basis: auto; }
  }
</style>
