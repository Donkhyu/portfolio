---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import AboutBlock from '../components/AboutBlock.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import ContactBlock from '../components/ContactBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectList from '../components/ProjectList.astro';
---

<BaseLayout>
  <Header slot="header" />

  <Hero />
  <AboutBlock />

  <section class="section container" id="work" aria-labelledby="work-h">
    <SectionHeading themed="Set & Spike" plain="Work" id="work-h" />
    <p class="work-intro">
      Every project is a rally — read the play, set it up, and spike. Here’s what
      I’ve shipped and what’s currently brewing.
    </p>
    <ProjectList />
  </section>

  <SkillsGrid />
  <ContactBlock />

  <Footer slot="footer" />
</BaseLayout>

<style>
  .work-intro {
    color: var(--text-muted);
    max-width: 52ch;
    margin-top: calc(-1 * var(--space-l));
    margin-bottom: var(--space-l);
  }
</style>
