---
import { site } from '../data/site';
// Status pill with a subtle CSS steam animation. No JS required;
// edit the text via `nowBrewing` in src/data/site.ts.
---

<span class="now-brewing" title="What I'm up to right now">
  <span class="cup" aria-hidden="true">
    <span class="steam"></span>
    <span class="steam"></span>
    <span class="steam"></span>
    <svg viewBox="0 0 24 24" width="16" height="16">
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 11h11v4a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z"></path>
        <path d="M16 12h2a2 2 0 0 1 0 4h-2"></path>
      </g>
    </svg>
  </span>
  <span class="label"><span class="lead">Now brewing</span> · {site.nowBrewing}</span>
</span>

<style>
  .now-brewing {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-s) var(--space-3xs) var(--space-2xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-raised);
    color: var(--text-muted);
    font-size: var(--fs--1);
    box-shadow: var(--shadow-warm);
  }
  .lead {
    color: var(--accent);
    font-weight: 600;
  }
  .cup {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }
  .steam {
    position: absolute;
    top: 0.05rem;
    width: 2px;
    height: 7px;
    border-radius: 2px;
    background: var(--glow);
    opacity: 0;
    filter: blur(0.4px);
    animation: steam 2.8s ease-in-out infinite;
  }
  .steam:nth-child(1) { left: 0.65rem; animation-delay: 0s; }
  .steam:nth-child(2) { left: 0.85rem; animation-delay: 0.5s; }
  .steam:nth-child(3) { left: 1.05rem; animation-delay: 1s; }

  @keyframes steam {
    0% { transform: translateY(2px) scaleY(0.6); opacity: 0; }
    35% { opacity: 0.7; }
    100% { transform: translateY(-7px) scaleY(1.1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .steam { animation: none; opacity: 0; }
  }
</style>
