---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="on-record container">
    <span class="or-label">On the record</span>
    <span class="or-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    {site.onTheRecord}
  </p>
  <div class="container footer-inner">
    <p class="footer-brand">{site.name}</p>
    <p class="footer-note">
      Brewed with Astro · served warm in {year}
    </p>
    <ul class="footer-links" role="list">
      {site.socials.map((s) => (
        <li>
          <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{s.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-l) var(--space-xl);
    margin-top: var(--space-2xl);
  }
  .on-record {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--fs--1);
    color: var(--text-muted);
    margin-bottom: var(--space-l);
  }
  .or-label {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  /* a tiny equalizer nod to the music */
  .or-eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
    margin-inline: 0.35rem 0.1rem;
  }
  .or-eq i {
    width: 3px;
    background: var(--accent-2);
    border-radius: 2px;
    animation: eq 1.1s ease-in-out infinite;
  }
  .or-eq i:nth-child(1) { height: 6px; animation-delay: 0s; }
  .or-eq i:nth-child(2) { height: 12px; animation-delay: 0.2s; }
  .or-eq i:nth-child(3) { height: 8px; animation-delay: 0.4s; }
  .or-eq i:nth-child(4) { height: 11px; animation-delay: 0.15s; }
  @keyframes eq {
    0%, 100% { transform: scaleY(0.5); }
    50% { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .or-eq i { animation: none; }
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
  }
  .footer-brand {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--heading);
    margin: 0;
  }
  .footer-note {
    font-size: var(--fs--1);
    color: var(--text-muted);
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    margin-left: auto;
  }
  .footer-links a {
    font-size: var(--fs--1);
    color: var(--text-muted);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--accent);
  }
</style>
