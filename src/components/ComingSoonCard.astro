---
// A deliberate "currently brewing" placeholder — not an empty box.
// Shown to keep the work grid feeling full and intentional until real
// projects are added; placeholders shrink to zero automatically.
interface Props {
  index?: number;
}
const { index = 0 } = Astro.props;

const lines = [
  'A project is steeping here — check back soon.',
  'Beans are grinding. Something’s on the way.',
  'Currently in the pour-over phase.',
];
const line = lines[index % lines.length];
---

<article class="coming-soon" aria-label="Upcoming project">
  <div class="cup" aria-hidden="true">
    <span class="steam"></span>
    <span class="steam"></span>
    <span class="steam"></span>
    <svg viewBox="0 0 32 32" width="34" height="34">
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 15h15v5a6 6 0 0 1-6 6h-3a6 6 0 0 1-6-6z"></path>
        <path d="M22 16h3a3 3 0 0 1 0 6h-3"></path>
      </g>
    </svg>
  </div>
  <span class="badge">Brewing</span>
  <p class="cs-line">{line}</p>
</article>

<style>
  .coming-soon {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-m);
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-raised));
    min-height: 11rem;
    justify-content: center;
  }
  .cup {
    position: relative;
    color: var(--accent);
  }
  .steam {
    position: absolute;
    top: -6px;
    width: 2px;
    height: 9px;
    border-radius: 2px;
    background: var(--glow);
    opacity: 0;
    filter: blur(0.5px);
    animation: cs-steam 3s ease-in-out infinite;
  }
  .steam:nth-child(1) { left: 9px; animation-delay: 0s; }
  .steam:nth-child(2) { left: 15px; animation-delay: 0.6s; }
  .steam:nth-child(3) { left: 21px; animation-delay: 1.2s; }
  @keyframes cs-steam {
    0% { transform: translateY(3px) scaleY(0.6); opacity: 0; }
    35% { opacity: 0.65; }
    100% { transform: translateY(-9px) scaleY(1.15); opacity: 0; }
  }
  .badge {
    font-family: var(--font-mono);
    font-size: var(--fs--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 0.15em 0.6em;
  }
  .cs-line {
    color: var(--text-muted);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .steam { animation: none; opacity: 0; }
  }
</style>
