---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section container" id="about" aria-labelledby="about-h">
  <SectionHeading themed="The Roast" plain="About" id="about-h" />
  <div class="about-grid">
    <div class="about-copy">
      {site.about.map((para) => <p>{para}</p>)}
    </div>
    <aside class="about-side" aria-label="At a glance">
      <ul role="list">
        <li><span class="k">Currently</span><span class="v">{site.role} @ {site.company}</span></li>
        <li><span class="k">Based in</span><span class="v">{site.location}</span></li>
        <li><span class="k">Off-hours</span><span class="v">Volleyball · Coffee · R&amp;B</span></li>
        <li><span class="k">On rotation</span><span class="v mono">{site.onTheRecord}</span></li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .about-copy p + p {
    margin-top: var(--space-s);
  }
  .about-side {
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--bg-raised);
    padding: var(--space-m);
  }
  .about-side ul {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }
  .about-side li {
    display: grid;
    gap: 0.15rem;
  }
  .k {
    font-family: var(--font-mono);
    font-size: var(--fs--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }
  .v {
    color: var(--text);
  }
  .v.mono {
    font-family: var(--font-mono);
    font-size: var(--fs--1);
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
