---
import { site } from '../data/site';
// ThemeToggle island is slotted in by index/layout in Phase 5.
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label={`${site.name} — home`}>
      <svg class="brand-mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 13h12v6a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5z"></path>
          <path d="M21 14h2.5a2.5 2.5 0 0 1 0 5H21"></path>
          <path d="M12 6.5c-.8 1.2-.8 2.3 0 3.5M16 6.5c-.8 1.2-.8 2.3 0 3.5"></path>
        </g>
      </svg>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul role="list">
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <slot name="toggle" />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--heading);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-1);
    letter-spacing: -0.01em;
  }
  .brand-mark {
    color: var(--accent);
    flex: none;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    margin: 0;
  }
  .site-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--fs--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--transition);
  }
  .site-nav a:hover {
    color: var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
  }
  .header-actions:empty {
    display: none;
  }

  @media (max-width: 36rem) {
    .brand-name {
      /* keep the mark, drop the wordmark to make room for nav */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }
</style>
